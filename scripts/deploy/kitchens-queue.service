# #26: Telegram webhook update'lari va bildirishnomalar navbati (queue worker).
# O'rnatish (serverda, sudo):
#   sudo cp scripts/deploy/kitchens-queue.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now kitchens-queue
# Deploydan keyin: php artisan queue:restart (worker yangi kodni oladi)
[Unit]
Description=Kitchens queue worker
After=network.target postgresql.service

[Service]
User=deploy
Group=www-data
WorkingDirectory=/var/www/kitchens/backend
ExecStart=/usr/bin/php artisan queue:work --sleep=1 --tries=5 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
